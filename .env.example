# ---------------------------------------------------------------------------
# fgl — runtime settings
#
#   cp .env.example .env      and fill in the values below.
#   .env is gitignored; .env.example is committed and must never hold secrets.
#
# Real environment variables always win over this file, so CI and containers
# can override anything here without editing it.
# Check what got picked up with:  fgl info
# ---------------------------------------------------------------------------

# --- Azure OpenAI (required for real runs; not needed for --dry-run) --------
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Model selection --------------------------------------------------------
# Overrides configs/base.yaml when set. This is the Azure *deployment* name,
# not the model name — swap it for a bigger deployment without touching YAML.
FGL_LLM_DEPLOYMENT=gpt-4o-mini

# Embeddings: sentence-transformers (local, default) | azure | hashing (offline)
FGL_EMBEDDING_PROVIDER=sentence-transformers
FGL_EMBEDDING_MODEL=all-MiniLM-L6-v2
FGL_EMBEDDING_AZURE_DEPLOYMENT=text-embedding-3-small

# --- Optional ---------------------------------------------------------------
# Pin the project root when running from an unusual working directory
# (the notebooks set this automatically).
# FGL_PROJECT_ROOT=/abs/path/to/fatgraph-locomo
