# ---------------------------------------------------------------------------
# fgl — configuração de runtime
#
#   cp .env.example .env      e preencha os valores abaixo.
#   .env é gitignored; .env.example é versionado e nunca contém segredo.
#
# ESTE É O ÚNICO ARQUIVO DE CONFIGURAÇÃO DE RUNTIME. Não há config.ini —
# havia, e ter dois lugares significava que "de onde veio a chave?" e "qual
# modelo esta rodada usou?" tinham duas respostas possíveis e nenhuma forma de
# saber qual estava valendo. Os YAML em configs/ descrevem o EXPERIMENTO; este
# arquivo descreve a MÁQUINA.
#
# Variáveis de ambiente reais sempre vencem este arquivo.
# Confira o que foi carregado com:  fgl info
# Teste o backend com uma chamada real:  fgl doctor
# ---------------------------------------------------------------------------

# ===========================================================================
# Credenciais
# ===========================================================================
# Azure direto:   https://<recurso>.openai.azure.com/
# Gateway corp.:  https://apit.exemplo.com.br/ia/openai/v1/openai-azure/openai
#
# Um endpoint que já contém caminho é detectado como base_url automaticamente
# (force com FGL_AZURE_USE_BASE_URL=true se a heurística errar). O mesmo
# cliente serve /chat/completions e /embeddings, então os embeddings do Azure
# herdam a CA e o base_url sem nenhuma configuração extra.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Certificado privado, quando o acesso é por gateway corporativo.
# Caminhos relativos são resolvidos a partir da RAIZ DO PROJETO — não do
# diretório de onde você chamou o comando.
# FGL_CA_BUNDLE=petrobras-ca-root.pem

# FGL_AZURE_USE_BASE_URL=true

# ===========================================================================
# Modelo de geração
# ===========================================================================
# Nome do *deployment*, não do modelo.
#
# ATENÇÃO a deployments de reasoning (gpt-5*, o1*, o3*, o4*): eles gastam o
# orçamento de tokens pensando ANTES de responder. O fgl detecta pelo nome e
# ajusta os parâmetros sozinho (max_completion_tokens, sem temperature,
# reasoning_effort=low). Ajuste em configs/base.yaml se precisar.
FGL_LLM_DEPLOYMENT=gpt-4-1-petrobras

# ===========================================================================
# Embeddings
# ===========================================================================
# provider: sentence-transformers (local, padrão) | azure | hashing (offline)
FGL_EMBEDDING_PROVIDER=local

# usado quando provider=sentence-transformers
FGL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# usado quando provider=azure. Nome do DEPLOYMENT.
#   embedding-3-large-global   3072 dimensões  (o mais forte do hub)
#   embedding-3-small-global   1536 dimensões
#   embedding-ada-002-global   1536 dimensões  (geração anterior)
FGL_EMBEDDING_AZURE_DEPLOYMENT=embedding-3-large-global

# Truncagem Matryoshka: vazio = largura cheia (3072). 1024 corta a memória do
# índice em 3x com perda pequena. A largura entra na chave do cache, então
# trocá-la INVALIDA o cache em vez de corrompê-lo.
FGL_EMBEDDING_AZURE_DIMENSIONS=

# ===========================================================================
# Opcional
# ===========================================================================
# Fixa a raiz do projeto ao rodar de um diretório incomum.
# FGL_PROJECT_ROOT=/abs/path/to/fatgraph-locomo
